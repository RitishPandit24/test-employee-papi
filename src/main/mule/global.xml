http://www.mulesoft.org/schema/mule/os http://www.mulesoft.org/schema/mule/os/current/mule-os.xsd">
	<configuration-properties doc:name="Env Configuration properties" doc:id="7501637b-230a-4f68-b78b-46cf4fc8271f" file="properties/${env}.properties" doc:description="Env specific properties" />
