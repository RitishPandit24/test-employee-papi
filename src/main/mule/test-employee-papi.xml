	<sub-flow name="get-employee-subFlow" doc:id="54d7fc02-d39f-4faf-9fdd-7a199706a026" >
		<http:request method="GET" doc:name="employee-sapi" doc:id="e1a1f828-d19d-4764-9e0f-27a8e3b1ffa7" config-ref="HTTP_Request_configuration" path="${employee.http.basepath}" sendCorrelationId="ALWAYS" correlationId="#[vars.correlationId]" />
		<ee:transform doc:name="Transform Message" doc:id="f9861fef-c4dd-4eb6-8233-0b82b5d1829b" >
			<ee:message >
				<ee:set-payload ><![CDATA[%dw 2.0
output application/json
---
payload.data filter($.id == vars.empid as Number)]]></ee:set-payload>
			</ee:message>
		</ee:transform>
	</sub-flow>
	<sub-flow name="post-employee-subFlow" doc:id="956b0808-8d85-46a6-b02e-8b46561b9d88" >
		<ee:transform doc:name="Transform Message" doc:id="6f3cf75e-13a7-4537-9697-87d8f5228cbc" >
			<ee:message >
				<ee:set-payload ><![CDATA[%dw 2.0
output application/json
---
if (payload.status? and payload.status != null) payload else payload ++ { status: "default" }]]></ee:set-payload>
			</ee:message>
		</ee:transform>
	</sub-flow>
